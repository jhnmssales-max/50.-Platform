# Postgres connection string for Supabase. Must be a role that is a member
# of the `authenticated` role (Supabase's default `postgres` connection
# already is) — the API issues `SET LOCAL ROLE authenticated` per request
# so that RLS policies apply, rather than bypassing them.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# From Supabase project settings → API → JWT Settings → JWT Secret.
# Used to verify the Authorization: Bearer <token> on every request.
SUPABASE_JWT_SECRET=

PORT=3000

# Postgres connection string for Supabase. Must be a role that is a member
# of the `authenticated` role (Supabase's default `postgres` connection
# already is) — the API issues `SET LOCAL ROLE authenticated` per request
# so that RLS policies apply, rather than bypassing them.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# From Supabase project settings → API → JWT Settings → JWT Secret.
# Used to verify the Authorization: Bearer <token> on every request.
SUPABASE_JWT_SECRET=

PORT=3000

# Number of proxy hops in front of this service (e.g. Render's own proxy
# = 1). Required for the public routes' per-IP rate limiting to key off
# the real client IP instead of the proxy's. Leave unset for local dev.
TRUST_PROXY=

# Postmark server token (Account → Servers → your server → API Tokens).
# Used to send the invite email from POST /api/customers.
POSTMARK_SERVER_TOKEN=

# The platform's single verified sender, used by every tenant until a
# tenant has its own verified domain (tenants.send_domain_verified).
EMAIL_FROM_ADDRESS=ben@goodstewardstructures.com

# Where the static frontend pages are actually served from, e.g.
# https://acme.50platform.com — used to build a real, clickable invite
# link (.../fifty-template-customer.html?code=...) for the email. Without
# this, the email falls back to the tenant's domain + the /50/... path
# scheme, which has no routing layer behind it yet and won't resolve.
FRONTEND_BASE_URL=

# Overrides Postmark's API base URL — for pointing at a local stand-in in
# tests. Leave unset in every real deployment.
POSTMARK_API_BASE=

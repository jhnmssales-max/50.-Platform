# Postgres connection string for Supabase. Must be a role that is a member
# of the `authenticated` role (Supabase's default `postgres` connection
# already is) — the API issues `SET LOCAL ROLE authenticated` per request
# so that RLS policies apply, rather than bypassing them. This connection
# is itself a superuser that bypasses RLS by default (that's exactly what
# each `SET LOCAL ROLE` downgrade is voluntarily giving up, one
# transaction at a time) — src/db.js's withServiceRole relies on that
# same bypass directly, for the one kind of code (a Stripe webhook, the
# reward-issuance worker) with no logged-in user to downgrade to in the
# first place. See "How dealer auth works" in api/README.md.
DATABASE_URL=postgresql://postgres:[password]@[host]:5432/postgres

# Your Supabase project's base URL, e.g. https://xxxx.supabase.co. Used to
# verify the Authorization: Bearer <token> on every request — tokens are
# checked against this project's own public signing key, fetched from
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json, not a static secret (this
# project's tokens are signed with an asymmetric key (ES256), not the
# legacy shared HS256 secret — a fixed secret can't verify those at all).
SUPABASE_URL=

# Overrides the JWKS URL derived from SUPABASE_URL above — for pointing at
# a local stand-in in tests (see scripts/serve_test_jwks.js). Leave unset
# in every real deployment.
SUPABASE_JWKS_URL=

PORT=3000

# Number of proxy hops in front of this service (e.g. Render's own proxy
# = 1). Required for the public routes' per-IP rate limiting to key off
# the real client IP instead of the proxy's. Leave unset for local dev.
TRUST_PROXY=

# Postmark server token (Account → Servers → your server → API Tokens).
# Used to send the invite email from POST /api/customers.
POSTMARK_SERVER_TOKEN=

# The platform's single verified sender, used by every tenant until a
# tenant has its own verified domain (tenants.send_domain_verified).
EMAIL_FROM_ADDRESS=ben@goodstewardstructures.com

# Where the static frontend pages are actually served from, e.g.
# https://acme.50platform.com — used to build a real, clickable invite
# link (.../fifty-template-customer.html?code=...) for the email. Without
# this, the email falls back to the tenant's domain + the /50/... path
# scheme, which has no routing layer behind it yet and won't resolve.
FRONTEND_BASE_URL=

# Overrides Postmark's API base URL — for pointing at a local stand-in in
# tests. Leave unset in every real deployment.
POSTMARK_API_BASE=

# Passphrase used to encrypt/decrypt each tenant's own Tremendous API key
# at rest (tenants.tremendous_api_key_encrypted, via pgcrypto's
# pgp_sym_encrypt/pgp_sym_decrypt). Never stored in the database — losing
# this means every tenant's stored key becomes undecryptable and each
# tenant has to reconnect their Tremendous account. Generate one with
# `openssl rand -base64 32`; do not reuse any other secret for this.
TENANT_CREDENTIALS_ENCRYPTION_KEY=

# Overrides Tremendous's API base URL — for pointing at their sandbox
# (https://testflight.tremendous.com/api/v2) or a local stand-in in tests.
# Leave unset to use their production API.
TREMENDOUS_API_BASE=

# Stripe secret key (Dashboard → Developers → API keys). Used for the
# one-time activation Checkout Session (POST /api/billing/checkout-session)
# and, from Stage 4 on, the per-referral reward charge. Use a test-mode
# key (sk_test_...) until this is genuinely ready for real dealer money.
STRIPE_SECRET_KEY=

# Signing secret for this webhook endpoint specifically (Dashboard →
# Developers → Webhooks → your endpoint → Signing secret), not the
# account-wide one. Verifies POST /api/webhooks/stripe's Stripe-Signature
# header against the raw request body — see src/lib/stripe.js's
# verifyWebhookSignature.
STRIPE_WEBHOOK_SECRET=

# Overrides Stripe's API base URL — for pointing at a local stand-in in
# tests. Leave unset in every real deployment.
STRIPE_API_BASE=

# Which gift card provider Stage 4's reward-issuance worker calls (see
# src/lib/giftCardProvider.js). Only 'stub' exists today — Tremendous
# declined to support the platform-funded model this worker needs, and
# Tango/Amazon Incentives are both pending an LLC and EIN. Leave unset to
# use the stub; set once a real provider is integrated.
GIFT_CARD_PROVIDER=

# Test-only: comma-separated gift_card_transactions.idempotency_key
# values (e.g. "<referral-id>:new_customer") the stub gift card provider
# should deliberately fail, to exercise the needs_refund path on demand.
# Never set outside a local/test environment.
GIFT_CARD_STUB_FAIL_KEYS=

# Global ceiling, in cents, on a single reward-issuance cycle's total
# intended charges (see src/workers/rewardIssuance.js) — independent of
# any tenant's own monthly_spend_cap_cents, since a per-tenant cap can't
# catch a bug that makes every tenant eligible at once. Required for a
# real (non-dry-run) run of the worker; a cycle whose total intended
# charges would exceed this processes nothing, logs loudly, and exits
# non-zero. Not required for `--dry-run`, which never spends anything.
REWARD_CYCLE_MAX_CENTS=
